{
  "redirects": [
    {
      "source": "/cpanel",
      "destination": "https://cpanel.apsinox.com",
      "permanent": false
    },
    {
      "source": "/cpanel/:path*",
      "destination": "https://cpanel.apsinox.com",
      "permanent": false
    },
    {
      "source": "/webmail",
      "destination": "https://webmail.apsinox.com",
      "permanent": false
    },
    {
      "source": "/webmail/:path*",
      "destination": "https://webmail.apsinox.com",
      "permanent": false
    },
    {
      "source": "/whm",
      "destination": "https://mail.apsinox.com:2087",
      "permanent": false
    },
    {
      "source": "/whm/:path*",
      "destination": "https://mail.apsinox.com:2087",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.apsinox.com"
        }
      ],
      "destination": "https://apsinox.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*|android-chrome.*|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
